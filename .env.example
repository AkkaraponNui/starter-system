# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase
# Supabase → Project Settings → API Keys (และ Data API สำหรับ Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# งานเสริม US-6 (ส่งอีเมลยืนยัน): ใส่เมื่อทำ US-6 เท่านั้น
# Resend → API Keys → Create API Key · รหัสลับ ใช้ฝั่ง server เท่านั้น ห้ามเติม NEXT_PUBLIC_ ข้างหน้า
# RESEND_API_KEY=re_your_key_here
